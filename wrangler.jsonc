{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vpprv1",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "vpprv1-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "vars": { "APP_NAME": "VPPRV1", "APP_VERSION": "1.0.0", "ENVIRONMENT": "production" },
  "observability": { "enabled": true }
}
