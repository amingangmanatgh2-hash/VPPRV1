<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VPPRV1.ViewModels"
        x:Class="VPPRV1.Views.MainWindow"
        Title="سامانه امن VPPRV1 - کلاینت ویندوز (Xray Core)"
        Width="380" Height="620"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#080C14"
        FlowDirection="RightToLeft">

  <Window.Styles>
    <Style Selector="Button.connect-btn">
      <Setter Property="Width" Value="170"/>
      <Setter Property="Height" Value="170"/>
      <Setter Property="CornerRadius" Value="85"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Center">
      <TextBlock Text="VPPRV1" FontSize="26" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Center"/>
      <TextBlock Text="نسل جدید اتصال هوشمند Xray Core &amp; VLESS" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
    </StackPanel>

    <!-- Main 5-State Connect Button & Pulse -->
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="24">
      <Button Classes="connect-btn"
              Command="{Binding ToggleConnectionAsync}"
              Background="#10B981"
              Foreground="#FFFFFF">
        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="⚡" FontSize="32" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
      </Button>

      <!-- Stats Grid -->
      <Border Background="#121A2B" CornerRadius="12" Padding="16" BorderBrush="#374151" BorderThickness="1">
        <Grid ColumnDefinitions="*,*">
          <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="مدت اتصال" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding DurationDisplay}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="تاخیر (Ping)" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding PingDisplay}" FontSize="16" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Footer Controls -->
    <StackPanel Grid.Row="2" Spacing="12">
      <Border Background="#121A2B" CornerRadius="10" Padding="12" BorderBrush="#374151" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0">
            <TextBlock Text="پروتکل VLESS + Reality" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="شبیه‌سازی امن TLS با هویت استاندارد مایکروسافت" FontSize="10" Foreground="#9CA3AF"/>
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsRealityMode}"/>
        </Grid>
      </Border>
    </StackPanel>
  </Grid>
</Window>
