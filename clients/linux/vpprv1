#!/usr/bin/env python3
"""
VPPRV1 Linux Command Line Interface (CLI)
ابزار خط فرمان رسمی و کاملاً فارسی سامانه VPPRV1 مبتنی بر Xray Core & VLESS
"""

import sys
import os
import json
import time
import argparse
import subprocess
import urllib.request
import urllib.error

CONFIG_DIR = os.path.expanduser("~/.config/vpprv1")
META_FILE = os.path.join(CONFIG_DIR, "meta.json")
CONFIG_JSON_FILE = os.path.join(CONFIG_DIR, "config.json")
XRAY_BIN = "/usr/local/bin/xray"

def to_persian_digits(num_str):
    mapping = {'0': '۰', '1': '۱', '2': '۲', '3': '۳', '4': '۴', '5': '۵', '6': '۶', '7': '۷', '8': '۸', '9': '۹'}
    return ''.join(mapping.get(c, c) for c in str(num_str))

def run_cmd(cmd):
    try:
        return subprocess.run(cmd, shell=True, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True).stdout.strip()
    except subprocess.CalledProcessError:
        return ""

def cmd_provision(api_url="https://vpprv1.workers.dev"):
    print("در حال صدور اشتراک جدید VLESS از سرور VPPRV1...")
    try:
        req = urllib.request.Request(f"{api_url}/api/v1/provision", data=b"{}", headers={"Content-Type": "application/json"}, method="POST")
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode())
            if data.get("success"):
                os.makedirs(CONFIG_DIR, exist_ok=True)
                with open(META_FILE, "w") as f:
                    json.dump(data, f, indent=2)
                print("اشتراک با موفقیت صادر شد!")
                print(f"توکن اشتراک: {data.get('token')}")
                print(f"شناسه کاربر (UUID): {data.get('uuid')}")
                print(f"نود متصل: {data.get('node_name')}")
                print(f"لینک VLESS: {data.get('vless_uri')}")
                return data
            else:
                print(f"خطا در صدور اشتراک: {data.get('error')}")
                return None
    except Exception as e:
        print(f"خطا در برقراری ارتباط با سرور: {e}")
        return None

def cmd_connect(api_url="https://vpprv1.workers.dev"):
    meta = None
    if os.path.exists(META_FILE):
        with open(META_FILE, "r") as f:
            try:
                meta = json.load(f)
            except Exception:
                pass
    
    if not meta or not meta.get("token"):
        meta = cmd_provision(api_url)
        if not meta:
            sys.exit(1)

    token = meta["token"]
    json_url = f"{api_url}/api/v1/sub/{token}?format=json"

    print("در حال دریافت کانفیگ کلاینت Xray...")
    try:
        with urllib.request.urlopen(json_url, timeout=10) as resp:
            conf_text = resp.read().decode('utf-8')
            with open(CONFIG_JSON_FILE, "w") as f:
                f.write(conf_text)
    except Exception as e:
        print(f"خطا در دریافت کانفیگ: {e}")
        sys.exit(1)

    print("در حال برقراری اتصال با هسته Xray Core...")
    if os.path.exists(XRAY_BIN):
        run_cmd("killall -9 xray 2>/dev/null || true")
        subprocess.Popen(f"{XRAY_BIN} run -c {CONFIG_JSON_FILE} > /dev/null 2>&1 &", shell=True)
    
    print("-------------------------------------------------------------")
    print("اتصال امن VLESS Reality با موفقیت برقرار شد!")
    print("پروکسی محلی SOCKS روی پورت 10808 و HTTP روی پورت 10809 فعال است.")
    print("جهت قطع اتصال از دستور: vpprv1 disconnect استفاده نمایید.")
    print("-------------------------------------------------------------")

def cmd_disconnect():
    print("در حال قطع اتصال Xray...")
    run_cmd("killall -9 xray 2>/dev/null || true")
    print("اتصال با موفقیت قطع شد.")

def cmd_status():
    res = run_cmd("pgrep -f 'xray run'")
    if res:
        print("================ وضعیت سرویس Xray Core ================")
        print("وضعیت: متصل 🟢")
        print("پروکسی فعال: 127.0.0.1:10808 (SOCKS5) / 127.0.0.1:10809 (HTTP)")
        print("=======================================================")
    else:
        print("وضعیت: قطع 🔴 (هیچ کانکشن فعالی وجود ندارد)")

def cmd_servers(api_url="https://vpprv1.workers.dev"):
    print("در حال دریافت لیست نودهای سرور Xray...")
    try:
        with urllib.request.urlopen(f"{api_url}/api/servers", timeout=10) as resp:
            data = json.loads(resp.read().decode())
            servers = data.get("servers", [])
            print("================ نودهای سرور VPPRV1 (Hetzner / Vultr / OVH) ================")
            for s in servers:
                status_icon = "🟢 آنلاین" if s.get("status") == "online" else "🔴 آفلاین"
                ping_str = to_persian_digits(s.get("latency", 0)) + " ms" if s.get("status") == "online" else "---"
                print(f"{s.get('flag')} {s.get('name'):<30} | {s.get('host'):<18} | {status_icon} | پینگ: {ping_str}")
            print("==========================================================================")
    except Exception as e:
        print(f"خطا در دریافت لیست نودها: {e}")

def main():
    parser = argparse.ArgumentParser(description="VPPRV1 Persian Linux Xray Core & VLESS Client")
    subparsers = parser.add_subparsers(dest="command")

    # connect
    p_conn = subparsers.add_parser("connect", help="برقراری اتصال امن VLESS")
    p_conn.add_argument("--api", default="https://vpprv1.workers.dev", help="آدرس API سرور")

    # disconnect
    subparsers.add_parser("disconnect", help="قطع اتصال")

    # status
    subparsers.add_parser("status", help="نمایش وضعیت اتصال")

    # servers
    subparsers.add_parser("servers", help="نمایش لیست نودها و پینگ")

    # provision
    subparsers.add_parser("provision", help="صدور اشتراک جدید VLESS")

    args = parser.parse_args()

    if args.command == "connect":
        cmd_connect(api_url=args.api)
    elif args.command == "disconnect":
        cmd_disconnect()
    elif args.command == "status":
        cmd_status()
    elif args.command == "servers":
        cmd_servers()
    elif args.command == "provision":
        cmd_provision()
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
